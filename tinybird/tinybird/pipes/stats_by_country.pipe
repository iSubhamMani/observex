DESCRIPTION "Visitor statistics by country"

TOKEN "stats_by_country_read_token" READ

NODE endpoint
SQL >
    %
    SELECT
        country,
        uniq(visitorId) as visitors
    FROM incoming_events
    WHERE websiteId = {{ String(websiteId, required=true) }}
        AND event_name = 'pageview'
        AND timestamp >= {{ DateTime(start, required=true) }}
        AND timestamp < {{ DateTime(end, required=true) }}
        AND country != '' AND country IS NOT NULL
    GROUP BY country
    ORDER BY visitors DESC
    LIMIT {{ Int32(limit, 50) }}
TYPE endpoint